{
  "name": "Palm Farm Field Map",
  "short_name": "PalmMap",
  "description": "Palm oil farm GIS field mapping app — GPS tracking, PDF map viewer, layer management and offline support for field workers.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f1a0f",
  "theme_color": "#1a2e1a",
  "lang": "ko",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "navigation"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://palmfarmmap.github.io/palm-farm-app/manifest.json",
      "id": "palm.farm.fieldmap"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://*.github.io"
    },
    {
      "origin": "https://analysis94.github.io"
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Palm Farm Field Map — GPS tracking on mobile"
    },
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Palm Farm Field Map — Desktop view"
    }
  ],
  "shortcuts": [
    {
      "name": "지도 열기",
      "short_name": "지도",
      "description": "GIS 팜 농장 지도 열기",
      "url": "./index.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "메모 목록",
      "short_name": "메모",
      "description": "현장 메모 목록 보기",
      "url": "./index.html#memos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/json": [
          ".json"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+palmmap",
      "url": "./index.html?action=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "mapfile",
          "accept": [
            "application/pdf",
            ".geojson",
            ".json",
            ".csv"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "Palm Farm GPS",
      "description": "현재 GPS 위치 표시",
      "tag": "gps-widget",
      "template": "generic-icon",
      "ms_ac_template": "widgets/gps-widget.json",
      "data": "widgets/gps-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "screenshot.png",
          "sizes": "390x844",
          "label": "GPS Widget"
        }
      ],
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "note_taking": {
    "new_note_url": "./index.html?action=new-memo"
  },
  "handle_links": "preferred"
}